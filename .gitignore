old/
*.har
*.bin
*.b64
nest_proto_*
secrets.yaml

# HA dev container config (holds credentials once the integration is set up)
config/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Editors
*~
*.swp
.vscode/

# Dev-tool credentials (Google session cookies) and the paste file used to create them
.credentials.json
